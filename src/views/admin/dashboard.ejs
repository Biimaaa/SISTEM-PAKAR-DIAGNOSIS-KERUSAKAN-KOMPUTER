<%- include('../partials/header', { judul: 'Dashboard Admin' }) %>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
  <div>
    <h1 class="h3 fw-bold mb-1">Dashboard Admin</h1>
    <p class="text-muted mb-0">Ringkasan basis pengetahuan dan aktivitas diagnosis.</p>
  </div>
  <a href="/admin/gejala" class="btn btn-outline-primary btn-sm">
    <i class="bi bi-gear me-1"></i>Kelola Basis Pengetahuan
  </a>
</div>

<%- include('../partials/admin_nav', { active: active }) %>

<div class="row g-3">
  <div class="col-6 col-lg-3">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="stat-value"><%= jumlah.gejala %></div>
        <div class="stat-label">Gejala</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="stat-value"><%= jumlah.kerusakan %></div>
        <div class="stat-label">Kerusakan</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-2">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="stat-value"><%= jumlah.diagnostik %></div>
        <div class="stat-label">Diagnostik</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-2">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="stat-value"><%= jumlah.aturanDiagnostik + jumlah.aturanCf %></div>
        <div class="stat-label">Total Aturan</div>
        <div class="small text-muted">
          <%= jumlah.aturanDiagnostik %> tahap 1 + <%= jumlah.aturanCf %> tahap 2
        </div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-2">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="stat-value"><%= jumlah.diagnosis %></div>
        <div class="stat-label">Diagnosis Tersimpan</div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4 mt-1">
  <div class="col-lg-7">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-bar-chart me-1"></i>Kerusakan Paling Sering Terdiagnosis</div>
      <div class="card-body">
        <% if (chartData.labels.length === 0) { %>
          <div class="text-center text-muted py-5">
            Belum ada data diagnosis untuk ditampilkan.
          </div>
        <% } else { %>
          <div style="height: 320px;">
            <canvas id="grafikKerusakan"></canvas>
          </div>
        <% } %>
      </div>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-info-circle me-1"></i>Komposisi Basis Pengetahuan</div>
      <ul class="list-group list-group-flush">
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <span>Gejala</span><span class="badge text-bg-primary"><%= jumlah.gejala %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <span>Diagnostik</span><span class="badge text-bg-primary"><%= jumlah.diagnostik %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <span>Kerusakan</span><span class="badge text-bg-primary"><%= jumlah.kerusakan %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <span>Aturan diagnostik</span><span class="badge text-bg-primary"><%= jumlah.aturanDiagnostik %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <span>Aturan CF</span><span class="badge text-bg-primary"><%= jumlah.aturanCf %></span>
        </li>
      </ul>
      <div class="card-body">
        <div class="d-grid gap-2">
          <a href="/admin/aturan-cf" class="btn btn-outline-primary btn-sm">Atur Bobot CF Pakar</a>
          <a href="/admin/pengaturan" class="btn btn-outline-secondary btn-sm">Ubah Ambang &amp; Kata Sandi</a>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card mt-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><i class="bi bi-clock-history me-1"></i>Diagnosis Terbaru</span>
    <a href="/admin/riwayat" class="btn btn-sm btn-outline-primary">Lihat Semua</a>
  </div>
  <div class="card-body">
    <% if (terbaru.length === 0) { %>
      <p class="text-muted mb-0">Belum ada diagnosis.</p>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>#</th>
              <th>Tanggal</th>
              <th>Perangkat</th>
              <th>Hasil Utama</th>
              <th class="text-end">CF</th>
              <th class="text-end">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% terbaru.forEach(function (d) { %>
              <tr>
                <td><%= d.id %></td>
                <td><%= formatTanggal(d.tanggal) %></td>
                <td><%= labelPerangkat(d.jenis_perangkat) %></td>
                <td>
                  <% if (d.hasil_utama) { %>
                    <span class="badge text-bg-secondary kode-badge"><%= d.hasil_utama %></span>
                    <%= d.hasil_nama || '' %>
                  <% } else { %>
                    <span class="text-muted">Tidak ada hasil</span>
                  <% } %>
                </td>
                <td class="text-end"><%= formatPersen(d.cf_hasil * 100) %></td>
                <td class="text-end">
                  <a href="/hasil/<%= d.id %>" class="btn btn-sm btn-outline-primary">Lihat</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
