<%- include('partials/header', { judul: 'Hasil Diagnosis' }) %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Beranda</a></li>
    <li class="breadcrumb-item"><a href="/diagnosis">Diagnosis</a></li>
    <li class="breadcrumb-item active" aria-current="page">Hasil #<%= diagnosis.id %></li>
  </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
  <div>
    <h1 class="h3 fw-bold mb-1">Hasil Diagnosis</h1>
    <p class="text-muted mb-1">
      Nomor <strong>#<%= diagnosis.id %></strong> &middot;
      <%= formatTanggal(diagnosis.tanggal) %> &middot;
      <span class="badge text-bg-primary"><%= labelPerangkat(diagnosis.jenis_perangkat) %></span>
    </p>
    <p class="small text-muted mb-0">
      Ambang CF yang dipakai: <strong><%= formatAngka(data.ambang) %></strong>
      (kerusakan di bawah ambang tidak ditampilkan).
    </p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <a href="/hasil/<%= diagnosis.id %>/pdf" class="btn btn-danger">
      <i class="bi bi-file-earmark-pdf me-1"></i>Unduh PDF
    </a>
    <a href="/diagnosis/gejala?perangkat=<%= diagnosis.jenis_perangkat %>" class="btn btn-outline-primary">
      <i class="bi bi-arrow-repeat me-1"></i>Diagnosis Ulang
    </a>
    <a href="/riwayat" class="btn btn-outline-secondary">Riwayat</a>
  </div>
</div>

<% if (data.hasil.length === 0) { %>
  <div class="alert alert-warning" role="alert">
    <h2 class="h6 alert-heading">Tidak ada kerusakan yang melewati ambang</h2>
    Gejala yang dipilih belum menghasilkan kerusakan dengan nilai CF minimal
    <strong><%= formatAngka(data.ambang) %></strong>. Coba tambahkan gejala lain yang benar-benar
    Anda amati, atau ulangi diagnosis dengan tingkat keyakinan yang sesuai.
  </div>
<% } else { %>
  <% const utama = data.hasil[0]; %>
  <div class="card hasil-utama mb-4">
    <div class="card-body">
      <div class="row align-items-center g-3">
        <div class="col-lg-8">
          <p class="text-uppercase text-muted small fw-semibold mb-1">Kemungkinan utama</p>
          <h2 class="h3 mb-1">
            <span class="badge text-bg-primary kode-badge"><%= utama.kode %></span>
            <%= utama.nama %>
          </h2>
          <p class="text-muted mb-0"><%= utama.deskripsi %></p>
        </div>
        <div class="col-lg-4 text-lg-end">
          <div class="persen-besar"><%= formatPersen(utama.persentase) %></div>
          <div class="text-muted small">tingkat keyakinan sistem</div>
          <div class="progress mt-2" role="progressbar" aria-label="Keyakinan utama"
            aria-valuenow="<%= utama.persentase %>" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar bg-primary" style="width: <%= utama.persentase %>%"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% } %>

<div class="card mb-4">
  <div class="card-header"><i class="bi bi-diagram-3 me-1"></i>Dugaan Kelompok Masalah (Forward Chaining)</div>
  <div class="card-body">
    <% if (data.dugaan.length === 0) { %>
      <p class="text-muted mb-0">Tidak ada kelompok masalah yang cocok dengan gejala terpilih.</p>
    <% } else { %>
      <div class="row g-3">
        <% data.dugaan.forEach(function (d) { %>
          <div class="col-md-6">
            <div class="border rounded p-3 h-100">
              <div class="d-flex justify-content-between align-items-start gap-2">
                <div>
                  <span class="badge text-bg-secondary kode-badge"><%= d.kode %></span>
                  <strong class="ms-1"><%= d.nama %></strong>
                </div>
                <span class="badge text-bg-light border">
                  Aturan <%= d.aturan.join(', ') %>
                </span>
              </div>
              <% if (d.kerusakan && d.kerusakan.length > 0) { %>
                <div class="small text-muted mt-2">
                  Kemungkinan kerusakan terkait:
                  <% d.kerusakan.forEach(function (k) { %>
                    <span class="badge text-bg-light border"><%= k.kode %> <%= k.nama %></span>
                  <% }); %>
                </div>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<% if (data.hasil.length > 0) { %>
  <%
    const BATAS_TAMPIL = 5;
    const teratas = data.hasil.slice(0, BATAS_TAMPIL);
    const sisanya = data.hasil.slice(BATAS_TAMPIL);
    const idSisanya = 'tampilkan-sisanya';
  %>
  <div class="card mb-4">
    <div class="card-header"><i class="bi bi-bar-chart-line me-1"></i>Peringkat Kerusakan Berdasarkan CF</div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th style="width: 50px;">#</th>
              <th>Kerusakan</th>
              <th style="min-width: 180px;">Keyakinan</th>
              <th class="text-end">Persentase</th>
            </tr>
          </thead>
          <tbody>
            <% teratas.forEach(function (item, indeks) { %>
              <tr>
                <td><%= indeks + 1 %></td>
                <td>
                  <span class="badge text-bg-secondary kode-badge"><%= item.kode %></span>
                  <strong class="ms-1"><%= item.nama %></strong>
                </td>
                <td>
                  <div class="progress" role="progressbar" aria-label="Keyakinan <%= item.kode %>"
                    aria-valuenow="<%= item.persentase %>" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar <%= indeks === 0 ? 'bg-primary' : 'bg-info' %>"
                      style="width: <%= item.persentase %>%"></div>
                  </div>
                </td>
                <td class="text-end fw-semibold"><%= formatPersen(item.persentase) %></td>
              </tr>
            <% }); %>
            <% sisanya.forEach(function (item, indeks) { %>
              <tr class="d-none tampil-sisanya" data-grup-sisa="<%= idSisanya || 'tampilkan' %>">
                <td><%= BATAS_TAMPIL + indeks + 1 %></td>
                <td>
                  <span class="badge text-bg-secondary kode-badge"><%= item.kode %></span>
                  <strong class="ms-1"><%= item.nama %></strong>
                </td>
                <td>
                  <div class="progress" role="progressbar" aria-label="Keyakinan <%= item.kode %>"
                    aria-valuenow="<%= item.persentase %>" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar bg-info" style="width: <%= item.persentase %>%"></div>
                  </div>
                </td>
                <td class="text-end fw-semibold"><%= formatPersen(item.persentase) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% if (sisanya.length > 0) { %>
        <button type="button" class="btn btn-sm btn-outline-secondary mt-2" id="btnTampilkanSisanya"
          data-grup-sisa="<%= idSisanya %>">
          <i class="bi bi-chevron-down me-1"></i>Tampilkan semua (<%= data.hasil.length %> kerusakan)
        </button>
      <% } %>
    </div>
  </div>

  <h2 class="h4 mb-3">Rincian dan Penjelasan</h2>

  <% data.hasil.forEach(function (item, indeks) { %>
    <div class="card mb-4">
      <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span>
          <span class="badge text-bg-primary kode-badge"><%= item.kode %></span>
          <span class="ms-1"><%= item.nama %></span>
        </span>
        <span class="badge text-bg-light border"><%= formatPersen(item.persentase) %></span>
      </div>
      <div class="card-body">
        <div class="row g-4">
          <div class="col-lg-7">
            <h3 class="h6">Gejala Pendukung</h3>
            <div class="table-responsive">
              <table class="table table-sm table-bordered align-middle">
                <thead class="table-light">
                  <tr>
                    <th>Gejala</th>
                    <th class="text-end">CF Pakar</th>
                    <th class="text-end">CF User</th>
                    <th class="text-end">CF Gejala</th>
                  </tr>
                </thead>
                <tbody>
                  <% item.gejalaPendukung.forEach(function (g) { %>
                    <tr>
                      <td>
                        <span class="badge text-bg-secondary kode-badge"><%= g.kode %></span>
                        <%= g.nama %>
                      </td>
                      <td class="text-end"><%= formatAngka(g.cfPakar) %></td>
                      <td class="text-end"><%= formatAngka(g.cfUser) %></td>
                      <td class="text-end"><%= formatAngka(g.cfGejala) %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <h3 class="h6 mt-3">Penjelasan Perhitungan</h3>
            <div class="accordion" id="akordeon-<%= item.kode %>">
              <div class="accordion-item">
                <h4 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#langkah-<%= item.kode %>" aria-expanded="false"
                    aria-controls="langkah-<%= item.kode %>">
                    Lihat langkah Certainty Factor
                  </button>
                </h4>
                <div id="langkah-<%= item.kode %>" class="accordion-collapse collapse"
                  data-bs-parent="#akordeon-<%= item.kode %>">
                  <div class="accordion-body langkah-perhitungan">
                    <p class="mb-2">
                      CF(gejala) = CF pakar &times; CF user. Untuk beberapa gejala, nilai digabung
                      berurutan dengan rumus CF lama + CF baru &times; (1 - CF lama).
                    </p>
                    <% item.langkah.forEach(function (l, i) { %>
                      <div class="border-start border-3 border-primary ps-3 mb-3">
                        <div class="fw-semibold">
                          Langkah <%= i + 1 %>
                          <span class="badge text-bg-light border ms-1">Aturan <%= l.aturan %></span>
                        </div>
                        <div><%= l.teksCf %></div>
                        <div><%= l.teksGabung %></div>
                      </div>
                    <% }); %>
                    <div class="fw-semibold">
                      CF akhir = <%= formatAngka(item.cf) %> &rarr;
                      <%= formatPersen(item.persentase) %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-5">
            <h3 class="h6">Deskripsi Kerusakan</h3>
            <p class="text-muted"><%= item.deskripsi %></p>

            <h3 class="h6">Saran Penanganan</h3>
            <div class="alert alert-light border solusi-teks mb-0"><%= item.solusi %></div>

            <% if (item.jenis_perangkat === 'laptop') { %>
              <p class="small text-muted mt-2 mb-0">
                <i class="bi bi-laptop me-1"></i>Kerusakan ini khusus perangkat laptop.
              </p>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  <% }); %>
<% } %>

<div class="alert alert-secondary small mb-0">
  <i class="bi bi-shield-exclamation me-1"></i>
  Hasil ini adalah diagnosis awal berbasis aturan dan tingkat keyakinan yang Anda masukkan.
  Untuk tindakan berisiko atau kerusakan perangkat keras, serahkan penanganan kepada teknisi.
</div>

<%- include('partials/footer') %>
