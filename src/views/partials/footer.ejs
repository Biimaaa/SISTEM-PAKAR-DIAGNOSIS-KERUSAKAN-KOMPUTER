    </div>
  </main>

  <footer class="footer mt-5 py-4 border-top bg-light">
    <div class="container">
      <div class="row gy-2 align-items-center">
        <div class="col-md-8">
          <p class="mb-1 fw-semibold">Sistem Pakar Diagnosis Kerusakan Laptop dan PC</p>
          <p class="mb-0 small text-muted">
            Dibuat untuk tugas kuliah dengan metode Forward Chaining dan Certainty Factor.
            Hasil diagnosis bersifat informatif, bukan pengganti pemeriksaan teknisi.
          </p>
        </div>
        <div class="col-md-4 text-md-end small text-muted">
          &copy; <%= typeof tahun !== 'undefined' ? tahun : new Date().getFullYear() %> Sistem Pakar
        </div>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <% if (typeof includeChart !== 'undefined' && includeChart) { %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
      var chartData = <%- JSON.stringify(chartData || { labels: [], values: [] })
        .replace(/</g, '\\u003c')
        .replace(/\u2028/g, '\\u2028')
        .replace(/\u2029/g, '\\u2029') %>;
      document.addEventListener('DOMContentLoaded', function () {
        var canvas = document.getElementById('grafikKerusakan');
        if (canvas && chartData) {
          new Chart(canvas, {
            type: 'bar',
            data: {
              labels: chartData.labels,
              datasets: [{
                label: 'Jumlah diagnosis',
                data: chartData.values,
                backgroundColor: 'rgba(13, 110, 253, 0.65)',
                borderColor: 'rgba(13, 110, 253, 1)',
                borderWidth: 1,
                borderRadius: 6
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              scales: {
                y: { beginAtZero: true, ticks: { precision: 0 } }
              },
              plugins: {
                legend: { display: false }
              }
            }
          });
        }
      });
    </script>
  <% } %>

  <% if (typeof includeDataTables !== 'undefined' && includeDataTables) { %>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        if (document.getElementById('tabelRiwayat') && window.jQuery) {
          jQuery('#tabelRiwayat').DataTable({
            language: {
              search: 'Cari:',
              lengthMenu: 'Tampilkan _MENU_ data',
              info: 'Menampilkan _START_ sampai _END_ dari _TOTAL_ data',
              infoEmpty: 'Tidak ada data',
              zeroRecords: 'Data tidak ditemukan',
              paginate: {
                first: 'Awal',
                last: 'Akhir',
                next: 'Berikutnya',
                previous: 'Sebelumnya'
              }
            },
            order: [[0, 'desc']]
          });
        }
      });
    </script>
  <% } %>

  <script src="/js/main.js"></script>
</body>
</html>
