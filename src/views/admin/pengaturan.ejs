<%- include('../partials/header', { judul: 'Pengaturan Admin' }) %>

<div class="mb-3">
  <h1 class="h3 fw-bold mb-1">Pengaturan</h1>
  <p class="text-muted mb-0">Atur ambang tampilan hasil dan ganti kata sandi admin.</p>
</div>

<%- include('../partials/admin_nav', { active: active }) %>

<div class="row g-4">
  <div class="col-lg-5">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-sliders me-1"></i>Ambang Certainty Factor</div>
      <div class="card-body">
        <p class="text-muted small">
          Kerusakan dengan CF akhir di bawah ambang tidak ditampilkan pada hasil diagnosis.
          Nilai default adalah 0,2.
        </p>
        <form action="/admin/pengaturan/ambang" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label for="ambang_cf" class="form-label">Nilai Ambang (0 - 1)</label>
            <input type="number" class="form-control" id="ambang_cf" name="ambang_cf"
              required min="0" max="1" step="0.01" value="<%= ambang %>">
            <div class="form-text">Saat ini tersimpan: <strong><%= ambang %></strong></div>
          </div>
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-save me-1"></i>Simpan Ambang
          </button>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-7">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-key me-1"></i>Ganti Kata Sandi</div>
      <div class="card-body">
        <p class="text-muted small">
          Akun: <strong><%= adminUser %></strong>. Gunakan kata sandi yang kuat dan tidak dipakai
          di layanan lain.
        </p>
        <form action="/admin/pengaturan/password" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label for="password_lama" class="form-label">Kata Sandi Lama</label>
            <input type="password" class="form-control" id="password_lama" name="password_lama"
              autocomplete="current-password" required maxlength="100">
          </div>
          <div class="mb-3">
            <label for="password_baru" class="form-label">Kata Sandi Baru</label>
            <input type="password" class="form-control" id="password_baru" name="password_baru"
              autocomplete="new-password" required minlength="6" maxlength="100">
          </div>
          <div class="mb-3">
            <label for="password_konfirmasi" class="form-label">Konfirmasi Kata Sandi Baru</label>
            <input type="password" class="form-control" id="password_konfirmasi"
              name="password_konfirmasi" autocomplete="new-password" required minlength="6" maxlength="100">
          </div>
          <button type="submit" class="btn btn-warning">
            <i class="bi bi-shield-lock me-1"></i>Ganti Kata Sandi
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<div class="alert alert-info mt-4 small mb-0">
  <i class="bi bi-info-circle me-1"></i>
  Perubahan bobot CF, aturan, dan ambang langsung dipakai untuk diagnosis berikutnya.
  Hasil diagnosis lama tetap menampilkan snapshot saat diagnosis dibuat.
</div>

<%- include('../partials/footer') %>
