<%- include('../partials/header', { judul: 'Kelola Aturan CF' }) %>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
  <div>
    <h1 class="h3 fw-bold mb-1">Kelola Aturan CF</h1>
    <p class="text-muted mb-0">
      Aturan tahap 2: menghubungkan gejala dengan kerusakan beserta bobot keyakinan pakar.
    </p>
  </div>
  <span class="badge text-bg-primary align-self-center"><%= items.length %> aturan</span>
</div>

<%- include('../partials/admin_nav', { active: active }) %>

<div class="row g-4">
  <div class="col-lg-4">
    <div class="card">
      <div class="card-header">
        <%= edit ? 'Ubah Aturan ' + edit.kode : 'Tambah Aturan CF' %>
      </div>
      <div class="card-body">
        <form action="<%= edit ? '/admin/aturan-cf/' + edit.id + '/update' : '/admin/aturan-cf' %>" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label for="kode" class="form-label">Kode</label>
            <input type="text" class="form-control" id="kode" name="kode" required maxlength="16"
              placeholder="R21" value="<%= edit ? edit.kode : '' %>">
          </div>
          <div class="mb-3">
            <label for="id_gejala" class="form-label">Gejala</label>
            <select class="form-select" id="id_gejala" name="id_gejala" required>
              <option value="">-- Pilih gejala --</option>
              <% gejala.forEach(function (g) { %>
                <option value="<%= g.id %>" <%= edit && Number(edit.id_gejala) === Number(g.id) ? 'selected' : '' %>>
                  <%= g.kode %> - <%= g.nama %>
                </option>
              <% }); %>
            </select>
          </div>
          <div class="mb-3">
            <label for="id_kerusakan" class="form-label">Kerusakan</label>
            <select class="form-select" id="id_kerusakan" name="id_kerusakan" required>
              <option value="">-- Pilih kerusakan --</option>
              <% kerusakan.forEach(function (k) { %>
                <option value="<%= k.id %>" <%= edit && Number(edit.id_kerusakan) === Number(k.id) ? 'selected' : '' %>>
                  <%= k.kode %> - <%= k.nama %>
                </option>
              <% }); %>
            </select>
          </div>
          <div class="mb-3">
            <label for="cf_pakar" class="form-label">CF Pakar</label>
            <input type="number" class="form-control" id="cf_pakar" name="cf_pakar" required
              min="0" max="1" step="0.01" value="<%= edit ? edit.cf_pakar : '0.6' %>">
            <div class="form-text">Nilai antara 0 dan 1 (contoh: 0.6).</div>
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-save me-1"></i><%= edit ? 'Simpan Perubahan' : 'Tambah' %>
            </button>
            <% if (edit) { %>
              <a href="/admin/aturan-cf" class="btn btn-outline-secondary">Batal</a>
            <% } %>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="card">
      <div class="card-header">Daftar Aturan CF</div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Kode</th>
                <th>Gejala</th>
                <th>Kerusakan</th>
                <th class="text-end">CF Pakar</th>
                <th class="text-end">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% items.forEach(function (a) { %>
                <tr>
                  <td><span class="badge text-bg-secondary kode-badge"><%= a.kode %></span></td>
                  <td>
                    <span class="badge text-bg-light border kode-badge"><%= a.gejala_kode %></span>
                    <%= a.gejala_nama %>
                  </td>
                  <td>
                    <span class="badge text-bg-light border kode-badge"><%= a.kerusakan_kode %></span>
                    <%= a.kerusakan_nama %>
                  </td>
                  <td class="text-end fw-semibold"><%= formatAngka(a.cf_pakar) %></td>
                  <td class="text-end table-aksi">
                    <a href="/admin/aturan-cf?edit=<%= a.id %>" class="btn btn-sm btn-outline-primary">Ubah</a>
                    <form action="/admin/aturan-cf/<%= a.id %>/hapus" method="post"
                      data-konfirmasi="Hapus aturan CF <%= a.kode %>?">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-sm btn-outline-danger">Hapus</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
