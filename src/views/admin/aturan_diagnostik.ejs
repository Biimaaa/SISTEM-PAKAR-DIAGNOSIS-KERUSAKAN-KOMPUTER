<%- include('../partials/header', { judul: 'Kelola Aturan Diagnostik' }) %>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
  <div>
    <h1 class="h3 fw-bold mb-1">Kelola Aturan Diagnostik</h1>
    <p class="text-muted mb-0">Aturan tahap 1 (forward chaining) dalam bentuk kondisi DAN/ATAU.</p>
  </div>
  <span class="badge text-bg-primary align-self-center"><%= items.length %> aturan</span>
</div>

<%- include('../partials/admin_nav', { active: active }) %>

<div class="row g-4">
  <div class="col-lg-5">
    <div class="card">
      <div class="card-header">
        <%= edit ? 'Ubah Aturan ' + edit.kode : 'Tambah Aturan Diagnostik' %>
      </div>
      <div class="card-body">
        <form action="<%= edit ? '/admin/aturan-diagnostik/' + edit.id + '/update' : '/admin/aturan-diagnostik' %>" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="row g-3">
            <div class="col-6">
              <label for="kode" class="form-label">Kode</label>
              <input type="text" class="form-control" id="kode" name="kode" required maxlength="16"
                placeholder="A09" value="<%= edit ? edit.kode : '' %>">
            </div>
            <div class="col-6">
              <label for="operator" class="form-label">Operator</label>
              <select class="form-select" id="operator" name="operator" required>
                <option value="OR" <%= edit && edit.kondisi.operator === 'OR' ? 'selected' : '' %>>OR (salah satu)</option>
                <option value="AND" <%= edit && edit.kondisi.operator === 'AND' ? 'selected' : '' %>>AND (semua)</option>
              </select>
            </div>
          </div>
          <div class="mb-3 mt-3">
            <label for="id_diagnostik" class="form-label">Diagnostik Tujuan</label>
            <select class="form-select" id="id_diagnostik" name="id_diagnostik" required>
              <option value="">-- Pilih diagnostik --</option>
              <% diagnostik.forEach(function (d) { %>
                <option value="<%= d.id %>" <%= edit && Number(edit.id_diagnostik) === Number(d.id) ? 'selected' : '' %>>
                  <%= d.kode %> - <%= d.nama %>
                </option>
              <% }); %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Gejala pada Kondisi</label>
            <div class="border rounded p-2 checkbox-gejala">
              <% gejala.forEach(function (g) { %>
                <% const dipilihGejala = edit && edit.kondisi.gejala.indexOf(g.kode) !== -1; %>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="gejala" value="<%= g.kode %>"
                    id="aturan-g-<%= g.kode %>" <%= dipilihGejala ? 'checked' : '' %>>
                  <label class="form-check-label" for="aturan-g-<%= g.kode %>">
                    <span class="badge text-bg-secondary kode-badge"><%= g.kode %></span>
                    <%= g.nama %>
                  </label>
                </div>
              <% }); %>
            </div>
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-save me-1"></i><%= edit ? 'Simpan Perubahan' : 'Tambah' %>
            </button>
            <% if (edit) { %>
              <a href="/admin/aturan-diagnostik" class="btn btn-outline-secondary">Batal</a>
            <% } %>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-7">
    <div class="card">
      <div class="card-header">Daftar Aturan Diagnostik</div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Kode</th>
                <th>Kondisi</th>
                <th>Diagnostik</th>
                <th class="text-end">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% items.forEach(function (a) { %>
                <tr>
                  <td><span class="badge text-bg-secondary kode-badge"><%= a.kode %></span></td>
                  <td class="small">
                    JIKA
                    <strong><%= a.kondisi.gejala.join(' ' + a.kondisi.operator + ' ') %></strong>
                    MAKA
                    <span class="badge text-bg-light border"><%= a.diagnostik_kode %></span>
                  </td>
                  <td><%= a.diagnostik_nama %></td>
                  <td class="text-end table-aksi">
                    <a href="/admin/aturan-diagnostik?edit=<%= a.id %>" class="btn btn-sm btn-outline-primary">Ubah</a>
                    <form action="/admin/aturan-diagnostik/<%= a.id %>/hapus" method="post"
                      data-konfirmasi="Hapus aturan diagnostik <%= a.kode %>?">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-sm btn-outline-danger">Hapus</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
