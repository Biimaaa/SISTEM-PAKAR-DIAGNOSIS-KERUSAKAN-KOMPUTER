<%- include('../partials/header', { judul: 'Login Admin' }) %>

<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card mt-4">
      <div class="card-body p-4">
        <div class="text-center mb-4">
          <div class="display-5 text-primary mb-2"><i class="bi bi-person-lock"></i></div>
          <h1 class="h4 mb-1">Login Admin</h1>
          <p class="text-muted small mb-0">Masuk untuk mengelola basis pengetahuan sistem pakar.</p>
        </div>

        <% if (keluar) { %>
          <div class="alert alert-info small">Anda telah keluar dari panel admin.</div>
        <% } %>

        <form action="/admin/login" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input type="text" class="form-control" id="username" name="username"
              autocomplete="username" required maxlength="50">
          </div>
          <div class="mb-3">
            <label for="password" class="form-label">Kata Sandi</label>
            <input type="password" class="form-control" id="password" name="password"
              autocomplete="current-password" required maxlength="100">
          </div>
          <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-box-arrow-in-right me-1"></i>Masuk
          </button>
        </form>

        <p class="small text-muted text-center mt-4 mb-0">
          Gunakan akun yang dibuat oleh script seed. Segera ganti kata sandi
          setelah login pertama.
        </p>
      </div>
    </div>
    <p class="text-center mt-3 mb-0">
      <a href="/" class="text-decoration-none small"><i class="bi bi-arrow-left me-1"></i>Kembali ke beranda</a>
    </p>
  </div>
</div>

<%- include('../partials/footer') %>
